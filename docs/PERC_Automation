nt, status)\n               VALUES (?, ?, ?, 'inbound', ?, ?, 'sent')\"\"\",\n            (generate_uuid(), conv_id, lead_id, data.content_type or \"text\", data.message),\n        )\n\n    # ── 5. Notify admins ──\n    admins = db.execute(\n        \"SELECT id FROM users WHERE role IN ('super_admin', 'admin') AND is_active = 1\"\n    ).fetchall()\n    for admin in admins:\n        db.execute(\n            \"\"\"INSERT INTO notifications (id, user_id, lead_id, notification_type,\n                                          title, message)\n               VALUES (?, ?, ?, 'new_lead', ?, ?)\"\"\",\n            (\n                generate_uuid(),\n                admin[\"id\"],\n                lead_id,\n                f\"New Lead: {data.first_name}\",\n                f\"{data.first_name} enquired via {data.source}\",\n            ),\n        )\n\n    db.commit()\n\n    return {\n        \"status\": \"success\",\n        \"lead_id\": lead_id,\n        \"workflow_id\": workflow_id,\n        \"message\": \"Lead created successfully\",\n    }\n\n\n@app.post(\"/api/messages\")\ndef receive_message(data: MessageInbound, db=Depends(get_db)):\n    \"\"\"Receive an inbound message from any channel.\"\"\"\n    # Verify lead exists\n    lead = db.execute(\"SELECT id FROM leads WHERE id = ?\", (data.lead_id,)).fetchone()\n    if not lead:\n        raise HTTPException(status_code=404, detail=\"Lead not found\")\n\n    # Find or create conversation\n    channel = db.execute(\n        \"SELECT id FROM channels WHERE name = ?\", (data.channel,)\n    ).fetchone()\n    channel_id = channel[\"id\"] if channel else \"chan_web_form\"\n\n    conv = db.execute(\n        \"\"\"SELECT id FROM conversations\n           WHERE lead_id = ? AND channel_id = ? AND status = 'active'\n           LIMIT 1\"\"\",\n        (data.lead_id, channel_id),\n    ).fetchone()\n\n    if not conv:\n        conv_id = generate_uuid()\n        db.execute(\n            \"\"\"INSERT INTO conversations (id, lead_id, cha